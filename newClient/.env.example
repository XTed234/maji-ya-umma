VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=maji-ya-umma.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=maji-ya-umma
VITE_FIREBASE_APP_ID=

