rules_version = '2';

// All data access goes through the backend (Firebase Admin SDK, which bypasses
// these rules). Browsers only use Firebase Auth, so they get no direct access
// to Firestore at all.
//
// Deploy rules + indexes with:
//   npx firebase-tools deploy --only firestore --project maji-ya-umma
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
